# --- Database -----------------------------------------------------------------
# Paste your MongoDB Atlas connection string here. The database name at the end
# of the path is created automatically on first write.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/versa-collections?retryWrites=true&w=majority

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Leave unset for localhost. Set to your apex domain in production.
COOKIE_DOMAIN=

# --- API docs -------------------------------------------------------------------
# Gates /api/docs behind HTTP Basic Auth. Leave either one unset and Swagger is
# not mounted at all — it never falls back to a default credential.
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Commerce -----------------------------------------------------------------
# All money is in minor units (integer paisa). 25000 = Rs 250.00
# SHIPPING_FLAT_RATE only seeds the delivery charge the first time the settings
# document is created. After that it is edited in the admin panel and this value
# is ignored — changing it here will not change the live fee.
SHIPPING_FLAT_RATE=25000
CURRENCY=PKR

# --- Uploads ------------------------------------------------------------------
# Legacy local directory. Nothing new is written here — media goes to Cloudinary
# — but it is still served so `/uploads/...` URLs frozen onto historical orders
# keep resolving. Relative to the project root; keep it out of version control.
UPLOAD_DIR=uploads

# --- Cloudinary ---------------------------------------------------------------
# From the dashboard at https://console.cloudinary.com. Uploads are refused
# until all three are set. Assets are filed as:
#   <root>/<year>/<collection>/<subcategory>/<productId>/<file>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=versacollections

# --- Email --------------------------------------------------------------------
# Order emails are skipped until HOST, USER and PASSWORD are all set.
# Port 465 uses implicit TLS; 587 upgrades with STARTTLS. SMTP_SECURE is derived
# from the port unless you set it explicitly.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The From header. Use an address on your own domain, or mail lands in spam.
MAIL_FROM=Versa Collections <orders@yourdomain.com>
MAIL_REPLY_TO=

# Where the "view your order" links in emails point.
STOREFRONT_URL=http://localhost:3000
