# --- Database -----------------------------------------------------------------
# Paste your MongoDB Atlas connection string here. The database name at the end
# of the path is created automatically on first write.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/versa-collections?retryWrites=true&w=majority

# --- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Leave unset for localhost. Set to your apex domain in production.
COOKIE_DOMAIN=

# --- Commerce -----------------------------------------------------------------
# All money is in minor units (integer cents). 4500 = $45.00
SHIPPING_FLAT_RATE=4500
FREE_SHIPPING_THRESHOLD=250000
CURRENCY=USD
